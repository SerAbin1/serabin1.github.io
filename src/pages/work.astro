---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiences } from '../data/experience';

/**
 * Splits a plain-text experience description into inline segments, converting
 * markdown-style links like [Label](https://example.com) into link nodes that
 * can be rendered as anchors.
 *
 * NOTE: This is a lightweight stopgap so markdown-style links stored in plain
 * strings render as real hyperlinks. If richer formatting is ever needed,
 * migrate the experience descriptions to structured data / MDX content.
 */
function parseInline(text: string) {
  const nodes: Array<{ type: 'text'; value: string } | { type: 'link'; label: string; href: string }> = [];
  /** Matches [Label](url) markdown-style links. */
  const linkRegex = /\[([^\]]+)\]\(([^)\s]+)\)/g;
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = linkRegex.exec(text)) !== null) {
    if (match.index > lastIndex) {
      nodes.push({ type: 'text', value: text.slice(lastIndex, match.index) });
    }
    nodes.push({ type: 'link', label: match[1], href: match[2] });
    lastIndex = linkRegex.lastIndex;
  }
  if (lastIndex < text.length) {
    nodes.push({ type: 'text', value: text.slice(lastIndex) });
  }
  return nodes;
}
---

<BaseLayout title="Work | Abin Biju" description="Where I've worked.">
  <h1 class="sr-only">Work</h1>
  <div class="divide-y divide-border">
    {experiences.map((e) => (
      <article class="py-6 first:pt-0">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h2 class="text-lg font-medium text-foreground">
            {e.title} <span class="text-muted-foreground">· {e.company}</span>
          </h2>
          <time class="text-sm text-muted-foreground font-mono shrink-0 tabular-nums">{e.period}</time>
        </div>
        <p class="text-xs text-muted-foreground mb-2">{e.location}</p>
        <ul class="space-y-1.5">
          {e.description.map((d) => (
            <li class="text-sm text-muted-foreground leading-relaxed">
              {parseInline(d).map((node) =>
                node.type === 'link' ? (
                  <a href={node.href} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline underline-offset-2">{node.label}</a>
                ) : (
                  node.value
                )
              )}
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs font-mono text-muted-foreground/80">{e.technologies.join(' · ')}</p>
      </article>
    ))}
  </div>
</BaseLayout>

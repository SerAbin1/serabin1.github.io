---
import BaseLayout from '../layouts/BaseLayout.astro';
import Experience from '../components/Experience';
import Projects from '../components/Projects';
import Blog from '../components/Blog';
import Footer from '../components/Footer';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
const posts = sortedPosts.map(post => ({
  title: post.data.title,
  description: post.data.description,
  date: post.data.date,
  id: post.id,
}));
---

<BaseLayout
  title="Abin Biju - Blog"
  description="Backend developer. I read, build and break stuff (in that order)."
>
  <div class="relative">
    <!--
      client:only="react" is used here because every section uses GSAP ScrollTrigger
      which requires a live browser DOM. Attempting SSR would fail with
      "element type is invalid" errors from CSS modules / browser-only APIs.
      The static <BaseLayout> shell (title, meta, OG tags) is fully server-rendered.
    -->
    <Blog posts={posts} client:only="react" />
    <Projects client:only="react" />
    <Experience client:only="react" />
    <Footer client:only="react" />
  </div>
</BaseLayout>

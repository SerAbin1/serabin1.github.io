---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

const formatDate = (d: string | Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Abin Biju - Blog"
  description="Backend developer. I read, build and break stuff (in that order)."
>
  <h1 class="sr-only">Blogs</h1>
  <div class="space-y-1">
    {posts.map((post) => (
      <a href={`/blogs/${post.id}/`} class="group block py-4 -mx-3 px-3 rounded-lg hover:bg-muted/50 transition-colors">
        <article class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
          <time class="text-sm text-muted-foreground font-mono shrink-0 tabular-nums w-32">
            {formatDate(post.data.date)}
          </time>
          <div class="flex-1 min-w-0">
            <h2 class="text-base font-medium text-foreground group-hover:text-primary transition-colors">
              {post.data.title}
            </h2>
            <p class="text-sm text-muted-foreground mt-0.5 line-clamp-1">{post.data.description}</p>
          </div>
        </article>
      </a>
    ))}
  </div>
</BaseLayout>

---
const sections = [
  { label: 'Blogs', href: '/', match: (p: string) => p === '/' || p.startsWith('/blogs') },
  { label: 'Projects', href: '/projects/', match: (p: string) => p.startsWith('/projects') },
  { label: 'Work', href: '/work/', match: (p: string) => p.startsWith('/work') },
  { label: 'About', href: '/about/', match: (p: string) => p.startsWith('/about') },
];

const path = Astro.url.pathname;
---

<header class="w-full px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto pt-8 sm:pt-10">
  <nav aria-label="Main" class="flex items-center gap-6 text-sm">
    {sections.map(({ label, href, match }) => {
      const active = match(path);
      return (
        <a
          href={href}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'relative pb-2 transition-colors',
            active ? 'text-foreground' : 'text-muted-foreground hover:text-foreground',
          ]}
        >
          {label}
          {active && (
            <span
              aria-hidden="true"
              class="absolute left-1/2 bottom-0 h-1 w-1 -translate-x-1/2 rounded-full bg-primary"
            />
          )}
        </a>
      );
    })}
  </nav>
</header>

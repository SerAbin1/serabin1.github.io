---
const year = new Date().getFullYear();

const links = [
  { label: 'GitHub', href: 'https://github.com/serabin1' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/abin-biju7' },
  { label: 'Mail', href: 'mailto:sonuabin7@gmail.com' },
  { label: 'I🖤RSS', href: 'https://iheartrss.com/' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="py-8 sm:py-12 mt-16 border-t border-border">
  <div class="w-full px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
    <div class="flex items-center gap-6 text-sm">
      {links.map(({ label, href }) => {
        const external = href.startsWith('http');
        return (
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            {label}
          </a>
        );
      })}
    </div>
    <p class="text-sm text-muted-foreground">© {year} Abin Biju</p>
  </div>
</footer>
